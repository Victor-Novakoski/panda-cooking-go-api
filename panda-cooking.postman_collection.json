{
  "info": {
    "name": "Panda Cooking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token salvo automaticamente');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"victor@email.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Registrar usuário",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Victor\",\n  \"email\": \"victor@email.com\",\n  \"password\": \"123456\",\n  \"image_profile\": \"https://i.pravatar.cc/150\"\n}"
            }
          }
        },
        {
          "name": "Ver perfil",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/profile",
            "header": []
          }
        },
        {
          "name": "Atualizar perfil",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/users/profile",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Victor Atualizado\",\n  \"image_profile\": \"https://i.pravatar.cc/200\"\n}"
            }
          }
        },
        {
          "name": "Deletar conta",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/profile",
            "header": []
          }
        },
        {
          "name": "Receitas favoritas do usuário",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/profile/favorite-recipes",
            "header": []
          }
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/categories",
            "header": []
          }
        }
      ]
    },
    {
      "name": "Receitas",
      "item": [
        {
          "name": "Listar receitas",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/recipes",
            "header": []
          }
        },
        {
          "name": "Buscar receita por ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/recipes/:id",
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              }
            ],
            "header": []
          }
        },
        {
          "name": "Criar receita",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/recipes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Panqueca Americana\",\n  \"description\": \"Panqueca fofinha e deliciosa\",\n  \"time\": \"20 minutos\",\n  \"portions\": 4,\n  \"category_id\": 1,\n  \"images\": [\n    { \"url\": \"https://example.com/panqueca.jpg\" }\n  ],\n  \"ingredients\": [\n    { \"name\": \"Farinha de Trigo\", \"amount\": \"2 xícaras\" },\n    { \"name\": \"Leite\",           \"amount\": \"1 xícara\" },\n    { \"name\": \"Ovo\",             \"amount\": \"2 unidades\" }\n  ],\n  \"preparations\": [\n    { \"description\": \"Misture todos os ingredientes secos\" },\n    { \"description\": \"Adicione o leite e os ovos e misture bem\" },\n    { \"description\": \"Frite em frigideira antiaderente por 2 minutos cada lado\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Atualizar receita",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/recipes/:id",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Panqueca Americana Atualizada\",\n  \"portions\": 6\n}"
            }
          }
        },
        {
          "name": "Deletar receita",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/recipes/:id",
            "header": [],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Receitas / Imagens",
      "item": [
        {
          "name": "Adicionar imagem",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/recipes/:id/images",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/nova-imagem.jpg\"\n}"
            }
          }
        },
        {
          "name": "Atualizar imagem",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/recipes/:id/images/:imageID",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              },
              {
                "key": "imageID",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/imagem-atualizada.jpg\"\n}"
            }
          }
        },
        {
          "name": "Deletar imagem",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/recipes/:id/images/:imageID",
            "header": [],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              },
              {
                "key": "imageID",
                "value": "1"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Receitas / Ingredientes",
      "item": [
        {
          "name": "Adicionar ingrediente",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/recipes/:id/ingredients",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manteiga\",\n  \"amount\": \"1 colher de sopa\"\n}"
            }
          }
        },
        {
          "name": "Remover ingrediente",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/recipes/:id/ingredients/:ingredientID",
            "header": [],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              },
              {
                "key": "ingredientID",
                "value": "1"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Receitas / Preparos",
      "item": [
        {
          "name": "Adicionar passo",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/recipes/:id/preparations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Sirva com mel e frutas\"\n}"
            }
          }
        },
        {
          "name": "Atualizar passo",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/recipes/:id/preparations/:prepID",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              },
              {
                "key": "prepID",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Sirva quente com mel e frutas frescas\"\n}"
            }
          }
        },
        {
          "name": "Deletar passo",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/recipes/:id/preparations/:prepID",
            "header": [],
            "variable": [
              {
                "key": "id",
                "value": "cole-o-id-aqui"
              },
              {
                "key": "prepID",
                "value": "1"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Comentários",
      "item": [
        {
          "name": "Listar comentários",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/comments",
            "header": []
          }
        },
        {
          "name": "Criar comentário",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/comments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Receita incrível, fiz ontem!\",\n  \"recipe_id\": \"cole-o-id-aqui\"\n}"
            }
          }
        },
        {
          "name": "Editar comentário",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/comments/:id",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "variable": [
              {
                "key": "id",
                "value": "1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Comentário editado\"\n}"
            }
          }
        },
        {
          "name": "Deletar comentário",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/comments/:id",
            "header": [],
            "variable": [
              {
                "key": "id",
                "value": "1"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Favoritos",
      "item": [
        {
          "name": "Favoritar receita",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/favorites/:recipeID",
            "header": [],
            "variable": [
              {
                "key": "recipeID",
                "value": "cole-o-id-aqui"
              }
            ]
          }
        },
        {
          "name": "Desfavoritar receita",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/favorites/:recipeID",
            "header": [],
            "variable": [
              {
                "key": "recipeID",
                "value": "cole-o-id-aqui"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "header": []
          }
        }
      ]
    }
  ]
}