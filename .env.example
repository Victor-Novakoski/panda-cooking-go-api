# development ou production (production recusa a SECRET_KEY de exemplo)
APP_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=panda_cooking
# obrigatória, 32+ caracteres. Gere uma com: openssl rand -base64 48
SECRET_KEY=troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais

# URL completa do banco (usado pelo seed)
DATABASE_URL=host=localhost user=postgres password=postgres dbname=panda_cooking port=5433 sslmode=disable
