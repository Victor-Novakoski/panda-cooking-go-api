# development ou production (production recusa a SECRET_KEY de exemplo)
APP_ENV=development
PORT=8080
# Dentro do docker compose a API usa o banco pela rede interna; estes valores
# valem para rodar a API fora do Docker. DB_PORT também é a porta publicada do banco.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=panda_cooking
# disable no banco local; require (ou verify-full) num banco gerenciado
DB_SSLMODE=disable
# obrigatória, 32+ caracteres. Gere uma com: openssl rand -base64 48
SECRET_KEY=troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais
# cria usuários e receitas de demonstração ao subir, se o banco não tiver usuário
SEED_DEMO=true
# origens do front que podem chamar a API pelo navegador, separadas por vírgula
# (em produção, https). O cookie de sessão só é aceito vindo delas.
CORS_ORIGINS=http://localhost:3000
# IPs ou faixas (CIDR) dos proxies na frente da API (o servidor do front, um
# proxy reverso). Só deles a API aceita o X-Forwarded-For como IP do cliente.
TRUSTED_PROXIES=
