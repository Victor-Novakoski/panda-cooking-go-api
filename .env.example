# development ou production (production recusa a SECRET_KEY de exemplo)
APP_ENV=development
PORT=8080
# Dentro do docker compose a API usa o banco pela rede interna; estes valores
# valem para rodar a API fora do Docker. DB_PORT também é a porta publicada do banco.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=panda_cooking
# obrigatória, 32+ caracteres. Gere uma com: openssl rand -base64 48
SECRET_KEY=troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais
# cria usuários e receitas de demonstração ao subir, se o banco não tiver usuário
SEED_DEMO=true
